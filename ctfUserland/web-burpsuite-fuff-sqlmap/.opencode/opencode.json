{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "burp": {
      "type": "remote",
      "url": "http://127.0.0.1:9876/sse",
      "enabled": false
    },
    "burpmcp": {
      "type": "remote",
      "url": "http://localhost:8181/mcp/sse",
      "enabled": false
    },
    "sqlmap": {
      "type": "local",
      "command": ["python", "/path/to/SQLMap-MCP/server.py"],
      "enabled": false
    },
    "ctf-mcp": {
      "type": "local",
      "command": ["ctf-mcp"],
      "enabled": false
    }
  }
}
