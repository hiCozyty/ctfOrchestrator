{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cyberchef": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "ghcr.io/doublegate/cyberchef-mcp_v1:latest"],
      "enabled": false
    },
    "ctf-mcp": {
      "type": "local",
      "command": ["ctf-mcp"],
      "enabled": false
    },
    "crypto-mcp": {
      "type": "local",
      "command": ["node", "/path/to/crypto-mcp/build/index.js"],
      "enabled": false
    },
    "hashcat-mordavid": {
      "type": "local",
      "command": ["python", "/path/to/Hashcat-MCP/hashcat_mcp_server.py"],
      "enabled": false
    },
    "hashcat-techchip": {
      "type": "local",
      "command": ["python3", "/path/to/hashcat-mcp/hashcatmcp.py"],
      "enabled": false
    }
  }
}
